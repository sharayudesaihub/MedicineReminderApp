<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Doctor Info -->
        <EditText
            android:id="@+id/etDoctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Doctor Name" />

        <EditText
            android:id="@+id/etHospitalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hospital Name" />

        <!-- Last Visit Dates -->
        <TextView
            android:text="Last Visit Dates"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/lastVisitList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnAddLastVisit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Last Visit Date" />

        <!-- Next Appointment -->
        <EditText
            android:id="@+id/etNextAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Next Appointment (dd/mm/yyyy hh:mm)"
            android:focusable="false"
            android:layout_marginTop="12dp"/>

        <!-- Set Reminder -->
        <Button
            android:id="@+id/btnSetReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Set Appointment Reminder" />
    </LinearLayout>
</ScrollView>
