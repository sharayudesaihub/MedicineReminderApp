<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/diseaseInfoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disease Information"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <!-- RadioGroup for Disease Selection -->
        <RadioGroup
            android:id="@+id/diseaseRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/radio_fever"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fever" />

            <RadioButton
                android:id="@+id/radio_diabetes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diabetes" />

            <RadioButton
                android:id="@+id/radio_cough"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cough" />
        </RadioGroup>

        <!-- Custom disease input -->
        <EditText
            android:id="@+id/addDiseaseEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your disease"
            android:inputType="text"
            android:visibility="gone"
            android:padding="8dp"/>

        <!-- Add disease button -->
        <Button
            android:id="@+id/addDiseaseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Custom Disease"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
