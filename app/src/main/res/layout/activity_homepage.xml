<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Homepage">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/homeToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:title="Medicine Reminder"
        android:titleTextColor="@android:color/white"/>

    <!-- Content Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <Button
            android:id="@+id/setReminderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Reminders"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/appointmentDetailsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appointment Details"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/diseaseInfoBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disease Information"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/casepaperBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Casepaper"
            android:layout_marginBottom="20dp" />

        <!-- Updated button to match the color of other buttons -->
        <Button
            android:id="@+id/refillReminderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Refill Reminder"
            android:layout_marginBottom="20dp" />
    </LinearLayout>

</LinearLayout>
