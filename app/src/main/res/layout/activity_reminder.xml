<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊 Set Medicine Reminder"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/reminderCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:layout_constraintTop_toBottomOf="@id/reminderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Medicine Name -->
                <EditText
                    android:id="@+id/medicineName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Medicine Name"
                    android:paddingStart="16dp" />

                <!-- Morning -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Morning"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TimePicker
                    android:id="@+id/morningTimePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:timePickerMode="clock" />

                <RadioGroup
                    android:id="@+id/morningRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/morningBeforeMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before Meal" />

                    <RadioButton
                        android:id="@+id/morningAfterMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="After Meal" />
                </RadioGroup>

                <!-- Afternoon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Afternoon"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TimePicker
                    android:id="@+id/afternoonTimePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:timePickerMode="clock" />

                <RadioGroup
                    android:id="@+id/afternoonRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/afternoonBeforeMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before Meal" />

                    <RadioButton
                        android:id="@+id/afternoonAfterMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="After Meal" />
                </RadioGroup>

                <!-- Night -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Night"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TimePicker
                    android:id="@+id/nightTimePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:timePickerMode="clock" />

                <RadioGroup
                    android:id="@+id/nightRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/nightBeforeMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before Meal" />

                    <RadioButton
                        android:id="@+id/nightAfterMeal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="After Meal" />
                </RadioGroup>

                <!-- Repeat -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Repeat"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/repeatRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radio_once"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Once" />

                    <RadioButton
                        android:id="@+id/radio_daily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily" />

                    <RadioButton
                        android:id="@+id/radio_weekly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly" />
                </RadioGroup>

                <!-- Buttons -->
                <Button
                    android:id="@+id/saveReminderButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/button_gradient"
                    android:text="Save Reminder"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/addMoreButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/button_gradient"
                    android:text="Add Another Medicine"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>