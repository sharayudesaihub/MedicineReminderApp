<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    tools:context=".ActivityReminder">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Set Medicine Reminders"
            android:textColor="#388E3C"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Medicine Name -->
        <EditText
            android:id="@+id/medicineName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter Medicine Name"
            android:padding="12dp"
            android:backgroundTint="#A5D6A7"
            android:textColorHint="#388E3C"
            android:textColor="#000000"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/reminderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Morning Section -->
        <TextView
            android:id="@+id/morningText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Morning"
            android:textColor="#0C0D0C"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/medicineName" />

        <android.widget.TimePicker
            android:id="@+id/morningTimePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:timePickerMode="spinner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/morningText" />

        <RadioGroup
            android:id="@+id/morningRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/morningTimePicker"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/morningBeforeMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before Meal"
                android:textColor="#388E3C" />

            <RadioButton
                android:id="@+id/morningAfterMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="After Meal"
                android:textColor="#388E3C" />
        </RadioGroup>

        <!-- Afternoon Section -->
        <TextView
            android:id="@+id/afternoonText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Afternoon"
            android:textColor="#0F0E0E"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/morningRadioGroup" />

        <android.widget.TimePicker
            android:id="@+id/afternoonTimePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/afternoonText"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/afternoonRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/afternoonTimePicker"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/afternoonBeforeMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before Meal"
                android:textColor="#388E3C" />

            <RadioButton
                android:id="@+id/afternoonAfterMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="After Meal"
                android:textColor="#388E3C" />
        </RadioGroup>

        <!-- Night Section -->
        <TextView
            android:id="@+id/nightText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Night"
            android:textSize="18sp"
            android:textColor="#0F0E0E"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/afternoonRadioGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <android.widget.TimePicker
            android:id="@+id/nightTimePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/nightText"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/nightRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/nightTimePicker"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/nightBeforeMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before Meal"
                android:textColor="#388E3C" />

            <RadioButton
                android:id="@+id/nightAfterMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="After Meal"
                android:textColor="#388E3C" />
        </RadioGroup>

        <!-- Repeat Options -->
        <TextView
            android:id="@+id/repeatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Repeat"
            android:textColor="#0F0E0E"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nightRadioGroup" />

        <RadioGroup
            android:id="@+id/repeatRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/repeatText"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/radio_once"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Once"
                android:textColor="#388E3C" />

            <RadioButton
                android:id="@+id/radio_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily"
                android:textColor="#388E3C" />

            <RadioButton
                android:id="@+id/radio_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly"
                android:textColor="#388E3C" />
        </RadioGroup>

        <!-- Save and Add Buttons -->
        <Button
            android:id="@+id/saveReminderButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save Reminder"
            android:textColor="#FFFFFF"
            android:backgroundTint="#388E3C"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/repeatRadioGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/addMoreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add Another Medicine"
            android:textColor="#388E3C"
            android:backgroundTint="#C8E6C9"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/saveReminderButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
